# Copy to .env.local for local development.
# In Cursor Cloud / Apps, set these as secrets (do not use NEXT_PUBLIC_ names there).
#
# Use the Project URL + publishable/anon key ONLY.
# Never put the secret service-role key here or commit real values to git.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key
# Alias also accepted:
# SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key
